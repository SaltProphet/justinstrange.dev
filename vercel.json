{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/research/article-01/:path*",
      "destination": "/research/",
      "permanent": false
    },
    {
      "source": "/research/article-02/:path*",
      "destination": "/research/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blog/instructions-my-ai-agent-wasnt-supposed-to-follow/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*([Bb][Oo][Tt]|[Cc]laude|[Gg][Pp][Tt]|[Aa]gent|[Hh]eadless|[Cc]url|[Pp]ython|[Ww]get|[Aa]xios|[Uu]ndici|[Ss]crapy|[Pp]erplexity|[Aa]nthropic|[Oo]pen[Aa][Ii]|[Nn]ode|[Gg]o-http|[Jj]ava|[Pp]ostman|[Ii]nsomnia|[Hh]ttpie|[Dd]art|[Oo]khttp|[Ff]etch).*"
          }
        }
      ],
      "destination": "/blog/instructions-my-ai-agent-wasnt-supposed-to-follow/agent.html"
    },
    {
      "source": "/blog/instructions-my-ai-agent-wasnt-supposed-to-follow/",
      "has": [
        {
          "type": "header",
          "key": "sec-ch-ua",
          "value": {
            "re": ".*[Hh]eadless.*"
          }
        }
      ],
      "destination": "/blog/instructions-my-ai-agent-wasnt-supposed-to-follow/agent.html"
    },
    {
      "source": "/blog/instructions-my-ai-agent-wasnt-supposed-to-follow/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*[Mm]ozilla.*"
          }
        }
      ],
      "destination": "/blog/instructions-my-ai-agent-wasnt-supposed-to-follow/clean.html"
    },
    {
      "source": "/blog/instructions-my-ai-agent-wasnt-supposed-to-follow/",
      "destination": "/blog/instructions-my-ai-agent-wasnt-supposed-to-follow/agent.html"
    }
  ]
}
